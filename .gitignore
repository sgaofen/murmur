app/node_modules/
app/dist/
app/dist-ssr/
app/src-tauri/target/
app/src-tauri/etcli/*
!app/src-tauri/etcli/.keep
cli/build/
cli/dist/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ===== Native binaries (committed via Git LFS or release) =====
